  tick label style={font=\small},
  label style={font=\small},
  legend style={
    font=\footnotesize,
    at={(0.03,0.97)},
    anchor=north west,
    draw=none,
    fill=none,
    inner sep=1pt,
    row sep=0.5pt,
  },
  grid=major,
  grid style={line width=0.3pt, gray!25},
